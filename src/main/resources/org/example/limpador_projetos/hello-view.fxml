<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.limpador_projetos.HelloController">
   <children>
      <HBox alignment="CENTER" prefHeight="500.0" prefWidth="600.0">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="600.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="40.0" prefWidth="600.0" spacing="16.0" style="-fx-padding: 10;">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Pasta para Limpar:" />
                        <Button fx:id="selectButton" mnemonicParsing="false" onAction="#onSelectDirectory" prefHeight="24.0" prefWidth="100.0" text="Selecionar" textFill="WHITE" />
                        <CheckBox fx:id="compressCheckBox" mnemonicParsing="false" text="Compactar Backup" />
                     </children>
                  </HBox>
                  
                  <Label fx:id="pathLabel" text="Nenhuma pasta selecionada" textFill="#888888" />

                  <HBox fx:id="destinationContainer" alignment="CENTER" managed="false" spacing="10.0" visible="false">
                     <children>
                        <Label text="Salvar ZIP em:" />
                        <Label fx:id="destinationLabel" style="-fx-font-style: italic;" text="Padrão (Mesma pasta)" />
                        <Button onAction="#onSelectDestination" text="Alterar Destino" />
                     </children>
                  </HBox>

                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="600.0" style="-fx-background-color: #222;" VBox.vgrow="ALWAYS">
                     <children>
                        <TextArea fx:id="logArea" editable="false" prefHeight="200.0" prefWidth="600.0" style="-fx-control-inner-background: #222; -fx-text-fill: #c1f700;" wrapText="true">
                           <font>
                              <Font name="Monospaced Regular" size="12.0" />
                           </font>
                        </TextArea>
                     </children>
                  </VBox>
                  
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button fx:id="cleanButton" onAction="#onStartCleaning" style="-fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" text="INICIAR" />
                     </children>
                  </HBox>
                  
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
